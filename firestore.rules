rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Menu data: public read (QR-first, no login), write restricted to
    // authenticated admin users only.
    match /categories/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /products/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Reviews: anyone can submit a review (no login required at the table),
    // but only admins can read, edit or delete them from the dashboard.
    match /reviews/{docId} {
      allow create: if request.resource.data.rating is int
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && request.resource.data.comment is string
                    && request.resource.data.comment.size() <= 1000;
      allow read, update, delete: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
