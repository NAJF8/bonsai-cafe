rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Menu data: public read (QR-first, no login), write restricted to
    // authenticated admin users only.
    match /categories/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /products/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Reviews: anyone can submit a review (no login required at the table),
    // but only admins can read, edit or delete them from the dashboard.
    match /reviews/{docId} {
      allow create: if request.resource.data.rating is int
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && request.resource.data.comment is string
                    && request.resource.data.comment.size() <= 1000;
      allow read, update, delete: if request.auth != null;
    }

    // Events: public read, admin-managed (created from the console/admin).
    match /events/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Membership / rewards: a member can look up or create their OWN
    // profile by phone (the document id). Points start at 0 and can only
    // be changed by staff (authenticated) — a client can never award
    // itself points, since that write can't be trusted without a backend
    // function to verify a real order happened.
    match /members/{phone} {
      allow get: if true;
      allow list: if request.auth != null;
      allow create: if request.resource.data.phone == phone
                    && request.resource.data.points == 0
                    && request.resource.data.name is string;
      allow update, delete: if request.auth != null;
    }

    // Gifts: anyone can create a gift order (validated below); only staff
    // can read/manage the queue and mark one redeemed.
    match /gifts/{docId} {
      allow create: if request.resource.data.code is string
                    && request.resource.data.senderName is string
                    && request.resource.data.recipientName is string
                    && request.resource.data.status == "pending";
      allow read, update, delete: if request.auth != null;
    }

    // Bookings (table / meeting space reservations): anyone can request
    // one; only staff can read/manage and confirm it.
    match /bookings/{docId} {
      allow create: if request.resource.data.name is string
                    && request.resource.data.phone is string
                    && request.resource.data.partySize is int
                    && request.resource.data.status == "pending";
      allow read, update, delete: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
